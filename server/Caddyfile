# Caddy: HTTPS for the API and the website on one server (used by docker-compose.site.yml).
# API_DOMAIN and SITE_DOMAIN come from server/.env. Certificates are issued and renewed automatically.

{$API_DOMAIN} {
	encode zstd gzip
	# HTTPS only from now on (a year), the API is never framed and types are not guessed
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Frame-Options DENY
	header X-Content-Type-Options nosniff
	reverse_proxy api:8787
}

{$SITE_DOMAIN} {
	encode zstd gzip
	root * /site

	# the server folder and git metadata are never served, whatever ends up in the site copy
	# (handle blocks with a matcher run before the catch-all handle below)
	@hidden path /server/* /.git/* /.git /src/* /tools/*
	handle @hidden {
		respond 404
	}

	# the site settings file is generated by `imorat` from .env (API address, Yandex Maps key)
	handle /config.js {
		root * /site-config
		header Cache-Control "no-cache"
		file_server
	}

	# the app shell and the service worker must always be fresh; images and fonts may be cached for long
	header /index.html Cache-Control "no-cache"
	header /sw.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "no-cache"
	@static path *.webp *.png *.jpg *.svg *.ico *.woff2 *.xlsx
	header @static Cache-Control "public, max-age=604800"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	# the page's own <meta> Content-Security-Policy lists the scripts it may run; framing can only be refused by a header
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Frame-Options DENY
	header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()"

	handle {
		try_files {path} {path}/ {path}.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
