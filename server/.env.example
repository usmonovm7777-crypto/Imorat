# ---------- Required ----------
# Domain of the API (DNS A-record → server IP). Caddy gets the HTTPS certificate automatically.
API_DOMAIN=api.imorat.uz
# Public address of the API (used for links to uploaded product photos)
PUBLIC_URL=https://api.imorat.uz
# Long random string: `openssl rand -hex 32`
JWT_SECRET=
# Phones of moderators who approve new stores (comma separated, 998XXXXXXXXX)
ADMIN_PHONES=998901234567
# Sites allowed to call the API
ALLOWED_ORIGINS=https://usmonovm7777-crypto.github.io,https://imorat.uz

# ---------- SMS (Eskiz.uz) ----------
# Without these the server works in test mode: the SMS code is shown on the site.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# The text must match a template approved in your Eskiz account; {code} is replaced with the code
SMS_TEMPLATE=Imorat: tasdiqlash kodi {code}. Kodni hech kimga bermang.

# ---------- Google / Apple sign-in ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web), add your site to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
# Apple Developer → Identifiers → Services ID (with Sign in with Apple, domain + return URL configured)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# ---------- Usta AI (Anthropic API) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=60
AI_GUEST_DAILY_LIMIT=15

# ---------- Yandex Delivery ----------
# OAuth token of the Yandex Delivery business account; without it delivery prices are estimated by the tariff formula
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_URL=https://b2b.taxi.yandex.net

# ---------- Telegram bot ----------
# Token from @BotFather. Sellers get orders with Accept / Out of stock buttons, buyers get order statuses.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (found automatically from the token; set it to show the link before the first start)
TELEGRAM_BOT_NAME=imoratGo_bot
# Address of the website (links in notifications)
SITE_URL=https://usmonovm7777-crypto.github.io/Imorat/

# ---------- Seller deadlines ----------
ACCEPT_REMIND_MIN=5
ACCEPT_SMS_MIN=10
ACCEPT_TIMEOUT_MIN=20
HANDOVER_HOURS=4
SMS_SELLER_TEMPLATE=Imorat: yangi buyurtma {num}. Iltimos, qabul qiling.

# ---------- Money ----------
# Commission by category, %; "*" = all other categories
COMMISSION=build:5,metal:5,fasten:5,*:10
# Online payment methods once the company and contracts exist, e.g. click,payme,uzum (empty = buyers pay the store directly)
PAYMENTS=

# ---------- Security ----------
# Admins must use a code from an authenticator app (0 = off, not recommended)
ADMIN_MFA=1
VAPID_SUBJECT=mailto:support@imorat.uz

# ---------- Other ----------
# VIP is free while payments are not connected (set 0 to turn off)
VIP_FREE=1
# 1 = new stores go live without moderation (not recommended)
STORE_AUTO_APPROVE=0

# ---------- Telegram channel ----------
# Channel for daily posts (product of the day, new products, price drops). Add the bot to the channel as an admin.
TELEGRAM_CHANNEL=@imoratgo
# Hour of the daily post, Tashkent time
CHANNEL_HOUR=10
# Price drop that gets posted (0.05 = 5%)
CHANNEL_DROP_PCT=0.05

# ---------- Bonuses and referrals (1 bonus = 1 so'm) ----------
BONUS_RATE=0.01
BONUS_RATE_PRO=0.02
# Share of the goods that can be paid with bonuses
BONUS_MAX_SHARE=0.2
# Friend's welcome bonus and the inviter's reward after the friend's first delivered order
BONUS_WELCOME=30000
BONUS_REFERRAL=30000

# ---------- Masters ----------
# SMS to a master about a new request (Eskiz needs the text approved; empty = no SMS, Telegram only)
SMS_MASTER_TEMPLATE=Imorat: sizga ustalik uchun yangi so‘rov keldi. Saytda qabul qiling.
# Phone sign-in attempts per IP per hour
OTP_PER_IP_HOUR=150
# Requests per IP per minute (many phones share one IP on mobile networks)
RATE_PER_IP_MIN=3000
