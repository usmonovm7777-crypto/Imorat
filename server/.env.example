# ---------- Required ----------
# Domain of the API (DNS A-record → server IP). Caddy gets the HTTPS certificate automatically.
API_DOMAIN=api.imorat.uz
# Public address of the API (used for links to uploaded product photos)
PUBLIC_URL=https://api.imorat.uz
# Long random string, at least 32 characters (production refuses shorter): `openssl rand -hex 32`
JWT_SECRET=
# Phones of moderators who approve new stores (comma separated, 998XXXXXXXXX)
ADMIN_PHONES=998901234567
# The owner's sign-in by login and password for the panel (besides the phones above). Set both with `imorat owner`
# (or node tools/owner.mjs hash): only the scrypt hash is stored, in single quotes so Docker Compose keeps the $ signs.
# OWNER_LOGIN=owner
# OWNER_PASSWORD_HASH='scrypt$16384$8$1$…$…'
# Helpers (moderation only, no money or analytics) are added by the owner in the panel: Панель Quriliş Go → Сотрудники.
# Sites allowed to call the API (the mobile app's own origins https://localhost and capacitor://localhost are always allowed)
ALLOWED_ORIGINS=https://usmonovm7777-crypto.github.io,https://imorat.uz

# ---------- Real site vs demo ----------
# 0 on the real site: the 9 sample stores and their prices are not shown; the catalogue fills up as real stores
# upload their price lists. Leave 1 (default) for a demo or a test server.
DEMO_STORES=0

# ---------- SMS (Eskiz.uz) ----------
# Without these the server works in test mode: the SMS code is shown on the site (production refuses to start like that).
# No SMS contract yet? Set SMS_MODE=telegram: people sign in through the Telegram bot (it asks for the contact), nothing is sent by SMS.
# SMS_MODE=telegram
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# The text must match a template approved in your Eskiz account; {code} is replaced with the code
SMS_TEMPLATE=Qurilish Go: tasdiqlash kodi {code}. Kodni hech kimga bermang.

# ---------- Google / Apple sign-in ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web), add your site to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
# Apple Developer → Identifiers → Services ID (with Sign in with Apple, domain + return URL configured)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# ---------- Usta AI (Anthropic API) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=60
AI_GUEST_DAILY_LIMIT=15

# ---------- Yandex Delivery ----------
# OAuth token of the Yandex Delivery business account. With it the price is exact, the courier is ordered automatically when
# the store has packed the order, statuses follow Yandex and the buyer sees the courier on the map (live position + Yandex Go link).
# Without it prices come from the tariff formula, the store moves the statuses and the buyer's map shows the store, the address
# and the real status with "Местоположение курьера недоступно" — no coordinates are invented.
YANDEX_DELIVERY_TOKEN=
# Test servers only: COURIER_SIMULATION=1 animates a pretend courier on the buyer's map when there is no Yandex token
# (a production server refuses to start with it).
# COURIER_SIMULATION=1
# Карты на сайте: ключ «JavaScript API и HTTP Геокодер» из кабинета разработчика Яндекса (developer.tech.yandex.ru).
# С ключом покупатель видит настоящую Яндекс Карту и подсказки адресов; без ключа — карта OpenStreetMap и поиск через Nominatim.
YANDEX_MAPS_KEY=
# отдельный ключ геокодера, если он не тот же самый (по умолчанию = YANDEX_MAPS_KEY)
YANDEX_GEOCODER_KEY=
YANDEX_DELIVERY_URL=https://b2b.taxi.yandex.net

# ---------- Telegram bot ----------
# Token from @BotFather. Sellers get orders with Accept / Out of stock buttons, buyers get order statuses.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (found automatically from the token; set it to show the link before the first start)
TELEGRAM_BOT_NAME=imoratGo_bot
# Address of the website (links in notifications)
SITE_URL=https://usmonovm7777-crypto.github.io/Imorat/

# ---------- Mobile app (Android / iPhone) push notifications ----------
# Android — Firebase Cloud Messaging: create a Firebase project, add the Android app uz.imorat.app, then
# Project settings → Service accounts → "Generate new private key" → save the JSON on the server and point to it:
FCM_SERVICE_ACCOUNT_FILE=
# iPhone — APNs: Apple Developer → Certificates, Identifiers & Profiles → Keys → new key with "Apple Push Notifications
# service" → download the .p8 once; its Key ID is shown next to it, the Team ID is in Membership details
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=uz.imorat.app
# sandbox for builds installed from Xcode, production for TestFlight and the App Store
APNS_ENV=production
# App-store reviewers' sign-in: phone:code — the code is fixed and nothing is sent (give the pair to Apple / Google in the review notes)
REVIEW_ACCOUNTS=

# ---------- Seller deadlines ----------
ACCEPT_REMIND_MIN=5
ACCEPT_SMS_MIN=10
ACCEPT_TIMEOUT_MIN=20
HANDOVER_HOURS=4
SMS_SELLER_TEMPLATE=Imorat: yangi buyurtma {num}. Iltimos, qabul qiling.

# ---------- Money ----------
# What a store pays from a card-paid order (two separate lines in its cabinet):
#  - Quriliş Go's commission by category, %; "*" = all categories (e.g. "build:1,*:2" for different rates)
COMMISSION=*:1
#  - the Payme/Click acquiring fee the bank charges on the payment, passed on as it is, %. Set the rate from your acquiring
#    contract once it is signed; one number for both, or per provider: "payme:2,click:1.8"
ACQUIRING_PERCENT=2
#  - a new store's first months after approval: Quriliş Go's commission is 0%, the acquiring fee stays (0 = no free months)
PROMO_MONTHS=3
# ---------- Bonus points (1 point = 1 so'm) — the only place these numbers live; the site, the app and the bot read them from the API ----------
# Бонусная программа (кешбэк баллами, приглашения). Выключена, пока владелец не включит её сам: BONUS_ON=1
BONUS_ON=0
# cashback share for buyers / masters (role pro). BONUS_RATE_VIP (default 0.03) only matters for orders placed before the VIP plan was dropped
BONUS_RATE=0.01
BONUS_RATE_PRO=0.02
# share of the goods that can be paid with points; max cashback per shipment; welcome/referral bonus (paid after the friend's first delivery); invites per code per month
BONUS_MAX_SHARE=0.2
BONUS_MAX_CASHBACK=200000
BONUS_WELCOME=30000
BONUS_REFERRAL=30000
BONUS_MAX_INVITES=20
# Who pays for points: Quriliş Go (stores always get the full price). Optional safety cap: points issued per calendar month,
# 0 = no cap. Points are earned only on bank-confirmed card orders and only on the part the buyer actually paid.
BONUS_MONTHLY_BUDGET=0
# ---------- Online card payment (Payme, Click) ----------
# A provider is offered at checkout as soon as its keys are set. The whole order — goods and delivery — is charged at once;
# the store sees the order only after the money arrives, unpaid orders cancel after PAY_TIMEOUT_MIN.
# Payme: Merchant cabinet → merchant ID and the key; set the callback URL to https://<API_DOMAIN>/api/pay/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# The sandbox (test) key marks orders paid without money. A production server refuses to start with it unless PAYME_SANDBOX=1 —
# set both only while Payme runs its integration test, then remove them.
PAYME_TEST_KEY=
PAYME_SANDBOX=
# Click: merchant cabinet → service ID, merchant ID, secret key; Prepare URL and Complete URL: https://<API_DOMAIN>/api/pay/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAY_TIMEOUT_MIN=30
# Orders are paid by card only. Until a provider's keys are set, checkout shows "payment coming soon" and the API answers 503 payments_off.
# "Stage 0" while no payment provider is connected (ALLOW_PAY_AT_STORE 1): buyers pay the store on receipt (pickup or the
# store's own courier), Quriliş Go holds no money and takes no commission; the store names its own delivery price. As soon as
# Payme/Click keys appear, card payment switches on and pay-at-store narrows to pickup only; set 0 for a card-only site.
ALLOW_PAY_AT_STORE=1
# Optional: narrow the offered providers, e.g. "payme" (empty = every provider with keys)
PAYMENTS=

# ---------- Security ----------
# Admins must use a code from an authenticator app (0 = off, not recommended)
ADMIN_MFA=1
# In production the server refuses to start while SMS is in test mode (codes in API responses). Set 1 only on a test server.
ALLOW_DEV_SMS=0
VAPID_SUBJECT=mailto:support@imorat.uz

# ---------- Other ----------
# 1 = new stores go live without moderation (not recommended)
STORE_AUTO_APPROVE=0
# 1: products a store adds and review texts go live at once (otherwise the owner or a helper approves them in the panel)
PRODUCT_AUTO_APPROVE=0
# AI 3D-модель товара по одному фото продавца — своя открытая нейросеть TripoSR (MIT), без платных API (server/ai3d/README.md).
# Обработчик server/ai3d/worker.py запускается на Mac (MPS) или отдельном сервере и сам забирает задачи по HTTPS с этим токеном.
# Пусто = функция выключена (на сайте нет кнопки). Токен: openssl rand -hex 32 — тот же в ~/.qurilish-ai3d.env на машине обработчика.
MODEL3D_WORKER_TOKEN=
# Лимит моделей на магазин в день, предел очереди, через сколько брошенная задача возвращается в очередь, максимальный размер GLB
MODEL3D_PER_STORE_DAY=30
MODEL3D_MAX_QUEUE=200
MODEL3D_JOB_TIMEOUT_MS=1200000
MODEL3D_MAX_GLB_MB=40
# Скидки: комплект −5%, промокод IMORAT5, опт −3/−6%, «завтра 10–14» −10%. Выключены, пока владелец не включит: DISCOUNTS_ON=1
DISCOUNTS_ON=0

# ---------- Telegram channel ----------
# Channel for daily posts (product of the day, new products, price drops). Add the bot to the channel as an admin.
TELEGRAM_CHANNEL=@imoratgo
# Hour of the daily post, Tashkent time
CHANNEL_HOUR=10
# Price drop that gets posted (0.05 = 5%)
CHANNEL_DROP_PCT=0.05

# ---------- Masters ----------
# SMS to a master about a new request (Eskiz needs the text approved; empty = no SMS, Telegram only)
SMS_MASTER_TEMPLATE=Imorat: sizga ustalik uchun yangi so‘rov keldi. Saytda qabul qiling.
# Phone sign-in attempts per IP per hour
OTP_PER_IP_HOUR=150
# Requests per IP per minute (many phones share one IP on mobile networks)
RATE_PER_IP_MIN=3000
